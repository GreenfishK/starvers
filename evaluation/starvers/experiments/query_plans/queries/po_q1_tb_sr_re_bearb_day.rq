
PREFIX vers: <https://github.com/GreenfishK/DataCitation/versioning/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?s{_:b1 rdf:reifies <<?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://dbpedia.org/ontology/Film>>> ; vers:valid_from ?valid_from_1 ; vers:valid_until ?valid_until_1 .
filter(?valid_from_1 <= ?tsBGP_0 && ?tsBGP_0 < ?valid_until_1)

bind("2022-10-01T12:00:00.000+00:00"^^xsd:dateTime as ?tsBGP_0)}