#############################################################
# for starvers.eval.Dockerfile containers
#############################################################
# datasets: bearb_day bearb_hour bearc orkg
datasets=bearb_day bearb_hour bearc orkg

# policies: ic_sr_ng tb_sr_ng tb_sr_rs tb_sr_re
policies=ic_sr_ng tb_sr_ng tb_sr_re tb_sr_rs

# triple_stores: graphdb jenatdb2_RDF_star jenatdb2_RDF1_2 ostrich
triple_stores=graphdb jenatdb2_RDF_star jenatdb2_RDF1_2 ostrich

# construct_datasets configs: whether or not to skip the construction of any of the datasets
skip_change_sets=True
skip_icng_ds=True
skip_tb_ds=True
skip_tb_star_ds=True
skip_tb_reif_ds=True
skip_tb_reif_rdf1_2_ds=False


